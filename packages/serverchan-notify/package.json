{
  "name": "dsh-serverchan-notify",
  "version": "1.0.1",
  "description": "DeepSeek Harness plugin: push a ServerChan3 (Server酱) notification whenever an agent turn finishes an answer — codex Stop-hook parity",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "smoke-test.mjs",
    "test-send.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node smoke-test.mjs",
    "test": "node smoke-test.mjs",
    "test:live": "node test-send.mjs",
    "prepack": "node smoke-test.mjs"
  },
  "sideEffects": false,
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "serverchan",
    "serverchan3",
    "server酱",
    "notification",
    "webhook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickhelion/dsh-plugins.git",
    "directory": "packages/serverchan-notify"
  },
  "homepage": "https://github.com/nickhelion/dsh-plugins/tree/main/packages/serverchan-notify#readme",
  "bugs": {
    "url": "https://github.com/nickhelion/dsh-plugins/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
